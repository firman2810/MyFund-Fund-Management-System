# true: use the in-memory mock API (src/services/mockApi.ts), no backend needed.
# false: call the Spring Boot backend.
# Unset: mock in `npm run dev`, real backend in `npm run build`.
# VITE_USE_MOCK=true

# Backend base URL. Defaults to /api, which vite.config.ts proxies to http://localhost:8080 in dev.
# VITE_API_BASE_URL=/api
